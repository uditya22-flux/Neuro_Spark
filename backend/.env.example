NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://mindbridge:mindbridge@localhost:5432/mindbridge?schema=public
JWT_SECRET=replace-with-a-random-development-secret
INTAKE_ENCRYPTION_KEY_BASE64=replace-with-a-32-byte-base64-key
CORS_ORIGIN=http://localhost:5173
LLM_PROVIDER=fake
# Keep this absent locally unless you are explicitly testing the approved
# server-side OpenAI adapter. Never place this key in Flutter or source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PARENT_VERIFICATION_PROVIDER=development-fixture
RAW_INTAKE_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90
