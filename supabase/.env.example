# Local Edge Function development only. This file is safe to commit.
# Put real values in ignored supabase/.env or in Supabase Dashboard secrets.
TASK_LLM_PROVIDER=openai
OPENAI_MODEL=your-approved-model
OPENAI_API_KEY=your-openai-key

# Synthetic-cloud Engine 2 showcase (Edge Function only)
SYNTHETIC_ENGINE2_CLOUD_ENABLED=true
# Optional: valid range is 76-200. The default is 100.
SYNTHETIC_ENGINE2_RATE_LIMIT_PER_HOUR=100

# Gen-UI: Groq
GROQ_API_KEY=your-groq-key
GROQ_MODEL=your-approved-model
GROQ_BASE_URL=https://api.groq.com/openai/v1
